# PostgreSQL (do not place real credentials in this tracked example)
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=go_pdf_forge
DB_USER=go_pdf_forge
DB_PASSWORD=<db-password>
DB_SSL_MODE=disable
DB_CONNECT_TIMEOUT=5s
DB_HEALTH_TIMEOUT=2s
DB_MIGRATION_TIMEOUT=2m
DB_MAX_CONNECTIONS=10
DB_MIN_CONNECTIONS=0
DB_MAX_CONNECTION_AGE=30m
DB_MAX_CONNECTION_IDLE=5m
DB_HEALTH_CHECK_PERIOD=30s

# Runtime limits
AUTH_MODE=optional
MAX_UPLOAD_BYTES=268435456
UPLOAD_CHUNK_BYTES=8388608
PDF_TARGET_BYTES=78643200
JOB_RETENTION=48h
WORKER_CONCURRENCY=1
ANONYMOUS_SESSION_TTL=48h
ANONYMOUS_TOKEN_PEPPER=<at-least-32-random-bytes>
ANONYMOUS_QUOTA_WINDOW=24h
ANONYMOUS_QUOTA_SESSIONS_PER_IP=20
ANONYMOUS_QUOTA_UPLOADS_PER_SESSION=10
ANONYMOUS_QUOTA_UPLOADS_PER_IP=50
ANONYMOUS_QUOTA_JOBS_PER_SESSION=10
ANONYMOUS_QUOTA_JOBS_PER_IP=50
ANONYMOUS_QUOTA_BYTES_PER_SESSION=1073741824
ANONYMOUS_QUOTA_BYTES_PER_IP=5368709120

# S3-compatible object storage / Garage
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=go-pdf-forge
S3_ACCESS_KEY_ID=<s3-access-key>
S3_SECRET_ACCESS_KEY=<s3-secret-key>
S3_PATH_STYLE=true

# SMTP: plain, starttls, or tls. Leave credentials empty for an internal relay.
SMTP_HOST=smtp.example.test
SMTP_PORT=25
SMTP_MODE=plain
SMTP_FROM=pdf@example.test
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CLIENT_HOSTNAME=
SMTP_TIMEOUT=10s
